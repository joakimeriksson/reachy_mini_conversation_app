# Deployment config: app on your Mac, robot = Reachy Mini Wireless, Ollama remote.
# Copy to .env and edit. See DEPLOY.md for the full guide.

# ===== Ollama (remote): Gemma audio STT + chat + tools/vision =====
# The Ollama host must listen on 0.0.0.0 and expose port 11434.
OLLAMA_URL="http://CHANGE-ME-OLLAMA-HOST:11434"
OLLAMA_MODEL="gemma4:latest"
# OLLAMA_STT_MODEL="gemma4:latest"     # defaults to OLLAMA_MODEL
# OLLAMA_TEMPERATURE=0.7               # unset = model default
# OLLAMA_NUM_CTX=4096                  # 0 = model default
OLLAMA_KEEP_ALIVE="30m"               # keep the model warm (remote first-load is slow)
# OLLAMA_THINK=0                       # chain-of-thought for chat (slower)

# ===== Text-to-speech backend =====
# "piper" (local, default) or "remote" (external on-prem voice generator).
# For a fully thin client, run the voice generator on a server and use:
# TTS_BACKEND="remote"
# TTS_URL="http://voicehost:8880/v1/audio/speech"   # OpenAI-compatible
# TTS_MODEL="tts-1"
# TTS_VOICE="alloy"
# TTS_FORMAT="wav"
# TTS_API_KEY=""

# ===== Piper TTS / Voice (TTS_BACKEND=piper, runs where the app runs) =====
PIPER_VOICE="en_US-lessac-medium"      # name in PIPER_DATA_DIR, or absolute .onnx path
PIPER_DATA_DIR="piper_voices"          # auto-downloaded on first run if missing
# PIPER_LENGTH_SCALE=1.0               # >1 slower, <1 faster
# PIPER_NOISE_SCALE=0.667              # expressiveness
# PIPER_NOISE_W_SCALE=0.8              # phoneme-length variation
# PIPER_VOLUME=1.0                     # output volume multiplier
# PIPER_SPEAKER_ID=-1                  # multi-speaker voices (-1 = default)

# ===== Voice-activity detection =====
VAD_AGGRESSIVENESS=2                    # 0=lenient .. 3=aggressive (raise to ignore noise)
VAD_SILENCE_MS=800                      # trailing silence that ends an utterance
# VAD_MIN_SPEECH_MS=200
# VAD_MAX_UTTERANCE_MS=15000

# ===== Personality =====
REACHY_MINI_CUSTOM_PROFILE="default"

# ===== Optional: external MCP tool servers =====
# MCP_SERVER_URLS="https://your-host/mcp api_key=..."
