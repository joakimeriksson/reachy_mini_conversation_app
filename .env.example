# ===== Ollama (Gemma: audio STT + chat + tools/vision) =====
# Server URL (native API at this root; OpenAI-compatible at <url>/v1).
OLLAMA_URL="http://localhost:11434"
# Conversation model — must support tool calling (+ audio for STT, + vision for camera).
OLLAMA_MODEL="gemma4:latest"
# Speech-to-text model (defaults to OLLAMA_MODEL when unset).
# OLLAMA_STT_MODEL="gemma4:latest"
# Sampling temperature (unset = model default).
# OLLAMA_TEMPERATURE=0.7
# Context window in tokens (0 = model default).
# OLLAMA_NUM_CTX=4096
# How long Ollama keeps the model loaded between calls ("5m", "30s", "-1"=forever).
OLLAMA_KEEP_ALIVE="5m"
# Enable chain-of-thought "thinking" for chat (slower; off by default).
# OLLAMA_THINK=0

# ===== Text-to-speech backend =====
# "piper" (local, default) or "remote" (external voice generator).
# TTS_BACKEND="piper"
# --- Remote voice generator (TTS_BACKEND=remote): OpenAI-compatible endpoint ---
# TTS_URL="http://voicehost:8880/v1/audio/speech"
# TTS_MODEL="tts-1"
# TTS_VOICE="alloy"
# TTS_FORMAT="wav"          # wav/flac/ogg (decoded via soundfile)
# TTS_API_KEY=""            # optional bearer token

# ===== Piper TTS / Voice (TTS_BACKEND=piper) =====
# Voice: a name resolvable in PIPER_DATA_DIR, or an absolute .onnx path.
PIPER_VOICE="en_US-lessac-medium"
# Directory holding downloaded Piper voices (auto-downloads on first use).
# PIPER_DATA_DIR="piper_voices"
# Speaking speed: >1 slower, <1 faster (unset = voice default).
# PIPER_LENGTH_SCALE=1.0
# Expressiveness / variation (unset = voice defaults).
# PIPER_NOISE_SCALE=0.667
# PIPER_NOISE_W_SCALE=0.8
# Output volume multiplier (1.0 = unchanged).
# PIPER_VOLUME=1.0
# Speaker id for multi-speaker voices (-1 = default).
# PIPER_SPEAKER_ID=-1

# ===== Voice-activity detection (see audio/vad.py) =====
# Aggressiveness 0=lenient .. 3=aggressive (raise if it never stops listening).
# VAD_AGGRESSIVENESS=2
# Trailing silence (ms) that ends an utterance.
# VAD_SILENCE_MS=800
# Min speech (ms) to count as an utterance; max utterance length before force-flush.
# VAD_MIN_SPEECH_MS=200
# VAD_MAX_UTTERANCE_MS=15000
# VAD detector: webrtc (light, classic) or silero (neural onnx, torch-free, more
# accurate at speech-vs-noise/echo — model auto-downloads). VAD_THRESHOLD is silero's
# speech probability (0..1).
# VAD_BACKEND=webrtc
# VAD_THRESHOLD=0.5

# Barge-in: interrupt Reachy mid-reply by talking over it (flushes output, re-listens).
# Needs echo control — on open speakers the mic hears Reachy and may self-interrupt;
# use headphones (or AEC). Raise BARGE_IN_SPEECH_MS if it triggers on its own voice.
# BARGE_IN=0
# BARGE_IN_SPEECH_MS=400
# Echo cancellation (needs the `aec` extra: livekit). Removes Reachy's own voice from
# the mic so barge-in works on open speakers, not just headphones.
# AEC=0

# HuggingFace cache (robot emotion + dance datasets). Camera vision is handled
# by the multimodal LLM (Gemma); there is no separate local vision model.
HF_HOME=./cache

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Profile selection (defaults to "default" when unset)
REACHY_MINI_CUSTOM_PROFILE="example"

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not listed in the selected profile's tools.txt.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# MCP server URLs (comma-separated endpoints for external tool servers)
# Supports both Streamable HTTP and SSE transports (auto-detected)
# Example: MCP_SERVER_URLS="http://192.168.1.50:8000/sse"
# Multiple: MCP_SERVER_URLS="http://host1:8000/sse,http://host2:9000/mcp"
# With token: MCP_SERVER_URLS="http://host1:8000/sse,https://secure.host/mcp token=eyJhbGci..."
# With API key (auto-fetches JWT): MCP_SERVER_URLS="https://dirigera.botbox.se/mcp api_key=your_key"
MCP_SERVER_URLS=
