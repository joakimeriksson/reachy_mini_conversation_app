# ===== Ollama (Gemma: hears audio, chats, sees, calls tools) =====
# Server URL (native API at this root; OpenAI-compatible at <url>/v1).
# Use the host's LAN IP, not localhost, when Ollama runs on another machine.
OLLAMA_URL="http://localhost:11434"
# Conversation model — must support tool calling (+ audio input, + vision for camera).
OLLAMA_MODEL="gemma4:latest"
# Feed the user's audio STRAIGHT into the chat model (default): one call instead of
# a separate transcribe-then-chat pass, ~2x lower latency, and the model hears tone.
# Set to 0 for a classic STT pipeline using OLLAMA_STT_MODEL.
# OLLAMA_DIRECT_AUDIO=1
# Speech-to-text model, only used when OLLAMA_DIRECT_AUDIO=0 (defaults to OLLAMA_MODEL).
# OLLAMA_STT_MODEL="gemma4:latest"
# Sampling temperature (unset = model default).
# OLLAMA_TEMPERATURE=0.7
# Context window in tokens (0 = model default).
# OLLAMA_NUM_CTX=4096
# How long Ollama keeps the model loaded between calls ("5m", "30s", "-1"=forever).
OLLAMA_KEEP_ALIVE="5m"
# Enable chain-of-thought "thinking" for chat (slower; off by default).
# OLLAMA_THINK=0

# ===== Voice server (REQUIRED — without it Reachy hears you but cannot speak) =====
# OpenAI-compatible /v1/audio/speech endpoint. Run voice-server/ (see its README),
# or point at any compatible server. Can also be set on the app's settings page.
TTS_URL="http://localhost:8880/v1/audio/speech"
# Voice name — MUST match the engine the voice server is running:
#   --engine kokoro       -> af_heart, af_bella, am_michael, bm_george, ...
#   --engine kokoro-svml  -> Stina, Alice, Anton, Björn, Elsa, Nils, ... (Swedish)
# A profile's voice.txt overrides this per personality.
TTS_VOICE="af_heart"
# TTS_MODEL="tts-1"
# TTS_FORMAT="wav"          # wav/flac/ogg (decoded via soundfile)
# TTS_API_KEY=""            # optional bearer token

# Whisper transcription on the same voice server. In direct-audio mode the app
# transcribes each turn WHILE the model thinks and stores the TEXT in history (lighter and
# KV-cache-friendly) instead of the raw audio. Defaults to the TTS_URL host.
# Requires starting the voice server with --whisper.
# STT_URL="http://localhost:8880/v1/audio/transcriptions"

# Noise gate (needs STT above): the VAD fires on any sustained sound, so without
# this Reachy answers chair scrapes and background noise. When Whisper hears no
# words in an utterance, the whole turn is silently dropped. On by default.
# NOISE_GATE=1

# ===== Voice-activity detection (see audio/vad.py) =====
# Aggressiveness 0=lenient .. 3=aggressive (raise if it never stops listening).
# VAD_AGGRESSIVENESS=2
# Trailing silence (ms) that ends an utterance.
# VAD_SILENCE_MS=500
# Min speech (ms) to count as an utterance; max utterance length before force-flush.
# VAD_MIN_SPEECH_MS=200
# VAD_MAX_UTTERANCE_MS=15000
# VAD detector: webrtc (light, classic) or silero (neural onnx, torch-free, more
# accurate at speech-vs-noise/echo — model auto-downloads; needs the `silero` extra).
# VAD_THRESHOLD is silero's speech probability (0..1).
# VAD_BACKEND=webrtc
# VAD_THRESHOLD=0.5

# ===== Barge-in and echo cancellation =====
# Interrupt Reachy mid-reply by talking over it (flushes output, re-listens).
# Needs echo control — on open speakers the mic hears Reachy and may self-interrupt;
# use headphones, or enable AEC below.
# BARGE_IN=0
# Sustained speech (ms) required to count as an interruption.
# BARGE_IN_SPEECH_MS=500
# Barge-in uses a STRICTER speech bar than normal listening so room noise / residual
# echo doesn't cut Reachy off. Higher = less sensitive.
# BARGE_IN_THRESHOLD=0.85
# Echo cancellation (needs the `aec` extra: livekit). Removes Reachy's own voice from
# the mic so barge-in works on open speakers, not just headphones.
# AEC=0
# Echo-path delay in ms. 0 = auto-calibrate at startup with a chirp; a positive value
# pins it (measure with scripts/aec_diag.py) and skips calibration.
# AEC_STREAM_DELAY_MS=0
# Log per-turn echo / residual / ERLE through the live audio path, for tuning AEC
# where aec_diag.py can't reach (e.g. through robot.media).
# AEC_DEBUG=0

# HuggingFace cache (robot emotion + dance datasets). Camera vision is handled
# by the multimodal LLM (Gemma); there is no separate local vision model.
HF_HOME=./cache

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Profile selection (defaults to "default" when unset)
REACHY_MINI_CUSTOM_PROFILE="example"

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not listed in the selected profile's tools.txt.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# MCP server URLs (comma-separated endpoints for external tool servers)
# Supports both Streamable HTTP and SSE transports (auto-detected)
# Example: MCP_SERVER_URLS="http://192.168.1.50:8000/sse"
# Multiple: MCP_SERVER_URLS="http://host1:8000/sse,http://host2:9000/mcp"
# With token: MCP_SERVER_URLS="http://host1:8000/sse,https://secure.host/mcp token=eyJhbGci..."
# With API key (auto-fetches JWT): MCP_SERVER_URLS="https://dirigera.botbox.se/mcp api_key=your_key"
MCP_SERVER_URLS=
