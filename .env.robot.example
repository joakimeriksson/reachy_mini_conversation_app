# Deployment config: app on your Mac, robot = Reachy Mini Wireless (body only).
# All heavy compute runs on the Mac; the robot provides mic/speaker/camera/motors
# over WiFi. Copy to .env and edit. See DEPLOY.md for the full guide.
#
#   ┌─────────────┐  WiFi (robot.media)  ┌──────────────────────────────────┐
#   │ Reachy Mini │◀────audio/cam/motor─▶│ Mac                              │
#   │  (body)     │                      │  reachy-local-assistant (app)    │
#   └─────────────┘                      │  Ollama gemma4      :11434       │
#                                        │  voice server (Kokoro-svml) :8880│
#                                        └──────────────────────────────────┘

# ===== Ollama (Gemma audio STT + chat + tools/vision) =====
# Running on THIS Mac -> localhost. (If remote, point at that host:11434 and
# start it with OLLAMA_HOST=0.0.0.0.)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4:latest"
# OLLAMA_STT_MODEL="gemma4:latest"     # defaults to OLLAMA_MODEL
# OLLAMA_TEMPERATURE=0.7               # unset = model default
# OLLAMA_NUM_CTX=4096                  # 0 = model default
OLLAMA_KEEP_ALIVE="30m"               # keep the model warm (remote first-load is slow)
# OLLAMA_THINK=0                       # chain-of-thought for chat (slower)

# ===== Text-to-speech: finished Swedish Kokoro voice server =====
# Speaks Swedish with YOUR trained model (Joakim/kokoro-sv-voices) and English
# with base Kokoro; clamped to sv,en so it never drifts into other languages.
# Start the server on this Mac (its own env; see voice-server/README.md):
#   cd voice-server && PYTORCH_ENABLE_MPS_FALLBACK=1 \
#     SWEDISH_KOKORO_PATH=~/work/swedish-kokoro \
#     uv run python ../scripts/voice_server.py --engine kokoro-svml --voice Stina
TTS_BACKEND="remote"
TTS_URL="http://localhost:8880/v1/audio/speech"
TTS_VOICE="Stina"                      # Swedish voices: Stina/Björn/Nils/Elsa/Anton/…
TTS_FORMAT="wav"
# TTS_API_KEY=""                       # only if the voice host requires a bearer token

# ===== Piper fallback (only used when TTS_BACKEND=piper) =====
PIPER_VOICE="en_US-lessac-medium"      # name in PIPER_DATA_DIR, or absolute .onnx path
PIPER_DATA_DIR="piper_voices"          # auto-downloaded on first run if missing
# PIPER_LENGTH_SCALE=1.0               # >1 slower, <1 faster
# PIPER_NOISE_SCALE=0.667              # expressiveness
# PIPER_NOISE_W_SCALE=0.8              # phoneme-length variation
# PIPER_VOLUME=1.0                     # output volume multiplier
# PIPER_SPEAKER_ID=-1                  # multi-speaker voices (-1 = default)

# ===== Voice-activity detection =====
VAD_AGGRESSIVENESS=2                    # 0=lenient .. 3=aggressive (raise to ignore noise)
VAD_SILENCE_MS=800                      # trailing silence that ends an utterance
# VAD_MIN_SPEECH_MS=200
# VAD_MAX_UTTERANCE_MS=15000

# ===== Personality =====
REACHY_MINI_CUSTOM_PROFILE="default"

# ===== Optional: external MCP tool servers =====
# MCP_SERVER_URLS="https://your-host/mcp api_key=..."
